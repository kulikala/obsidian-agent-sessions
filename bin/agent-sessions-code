#!/bin/sh
# Calls `agent-sessions edit` under a name whose basename includes "code".
# Claude Code treats an external editor as a GUI editor when its
# executable's basename contains code/cursor/…, and in that case does not
# switch to the alternate screen. Even when invoked through the symlink
# (~/bin/agent-sessions-code), this calls the real `agent-sessions` next to
# it. Older macOS lacks `readlink -f`, so this follows one symlink hop by
# hand and then resolves the absolute path with `cd … && pwd -P`.
SELF="$0"
if [ -L "$SELF" ]; then
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
fi
HERE="$(cd "$(dirname "$SELF")" && pwd -P)"
exec "$HERE/agent-sessions" edit "$@"
