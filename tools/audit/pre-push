#!/bin/sh
# Git pre-push hook: runs the audit on the commits about to be pushed and on the working tree.
#
# Install (once per clone, from the repository root):
#   ln -s ../../tools/audit/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
#
# A pushed tag (refs/tags/*) also runs the price check (tools/prices/check_prices.py): a price that differs
# from Anthropic's pricing page blocks the push, a page that cannot be read (offline) only warns.
# AUDIT_SKIP_PRICES=1 leaves it out.
#
# AUDIT_SKIP_TESTS=1 leaves out eslint, the build and the test suites. `git push --no-verify` skips the
# hook altogether.

root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
status=0

# Compares agentsessions/usage/pricing.py with the pricing page. Returns 1 on a difference.
check_prices() {
	python3 "$root/tools/prices/check_prices.py"
	case $? in
	0) return 0 ;;
	1)
		echo "prices: the price table differs from the pricing page; update agentsessions/usage/pricing.py" >&2
		echo "prices: (python3 tools/prices/check_prices.py --suggest prints the rows), or push with --no-verify" >&2
		return 1
		;;
	*)
		echo "prices: could not check the pricing page; verify the table by hand before releasing" >&2
		return 0
		;;
	esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
	# A deleted branch pushes nothing.
	[ "$local_sha" = "$zero" ] && continue
	# A tag: the commits were audited when the branch was pushed; check the prices before the release.
	case "$local_ref" in
	refs/tags/*)
		[ -z "$AUDIT_SKIP_PRICES" ] && { check_prices || status=1; }
		continue
		;;
	esac
	if [ "$remote_sha" = "$zero" ]; then
		# A new branch: what it adds on top of what the remote already has.
		if git rev-parse --verify --quiet origin/main >/dev/null; then
			range="origin/main..$local_sha"
		else
			range="$local_sha"
		fi
	else
		range="$remote_sha..$local_sha"
	fi
	echo "audit: $local_ref -> $remote_ref ($range)" >&2
	set -- --range "$range"
	[ -n "$AUDIT_SKIP_TESTS" ] && set -- "$@" --skip-tests
	node "$root/tools/audit/run.mjs" "$@" || status=1
done

if [ "$status" -ne 0 ]; then
	echo "audit: failed; fix the findings above, or push with --no-verify to skip the checks" >&2
fi
exit "$status"
